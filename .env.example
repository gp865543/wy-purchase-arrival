# Development: real unified backend by default.
IDENTITY_API_PROXY=http://127.0.0.1:16101
PURCHASE_ARRIVAL_API_PROXY=http://127.0.0.1:16101
# Set only the business proxy to http://localhost:5321 to use shared Mock.
VITE_BASE=/apps/purchase-arrival/
VITE_API_BASE=/api/v1
# Development defaults to the current host on port 16001, /auth/login.
# Production example for the /wuying3 deployment:
# VITE_BASE=/wuying3/apps/purchase-arrival/
# VITE_API_BASE=/wuying3/api/v1
# VITE_PORTAL_LOGIN=/wuying3/#/auth/login